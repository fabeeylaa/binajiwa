{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://binajiwa-production.up.railway.app/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://binajiwa-production.up.railway.app/socket.io/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://binajiwa-production.up.railway.app/socket.io/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}